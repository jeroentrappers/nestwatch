    <!-- Permissions (security.md PRIV-4) -->
    <string name="perm_mic_title">Mikrofon</string>
    <string name="perm_mic_station">Die Babystation hört ins Zimmer, damit deine Elterngeräte es hören können. Audio geht nur an Geräte, die du gekoppelt hast.</string>
    <string name="perm_mic_talk">Zurücksprechen sendet deine Stimme an die Babystation, solange du die Taste gedrückt hältst.</string>
    <string name="perm_camera_title">Kamera</string>
    <string name="perm_camera_station">Erlaube die Kamera, damit ein gekoppeltes Elterngerät auf Anfrage ein Livebild öffnen kann. Sonst ist die Kamera aus, und dieser Bildschirm zeigt an, wenn sie an ist.</string>
    <string name="perm_camera_scan">Die Kamera wird zum Scannen des QR-Codes zum Koppeln der Babystation verwendet. Es wird nichts aufgezeichnet.</string>
    <string name="perm_notifications_title">Benachrichtigungen</string>
    <string name="perm_notifications">Nestwatch benachrichtigt dich, wenn es in einem Zimmer laut wird, eine Babystation nicht erreichbar ist oder ihr Akku schwach wird.</string>
