    <!-- Tilladelser (security.md PRIV-4) -->
    <string name="perm_mic_title">Mikrofon</string>
    <string name="perm_mic_station">Babystationen lytter til værelset, så dine forælderenheder kan høre det. Lyden går kun til enheder, du har parret.</string>
    <string name="perm_mic_talk">Tal tilbage sender din stemme til babystationen, mens du holder knappen nede.</string>
    <string name="perm_camera_title">Kamera</string>
    <string name="perm_camera_station">Tillad kameraet, så en parret forælderenhed kan åbne en livevisning efter ønske. Ellers er kameraet slukket, og denne skærm viser, når det er tændt.</string>
    <string name="perm_camera_scan">Kameraet bruges til at scanne babystationens QR-kode til parring. Intet bliver optaget.</string>
    <string name="perm_notifications_title">Notifikationer</string>
    <string name="perm_notifications">Nestwatch giver besked, når et værelse bliver højlydt, en babystation ikke kan nås, eller dens batteri er ved at løbe tør.</string>
