    <string name="app_name">Nestwatch</string>
    <string name="promise">En privat babyalarm til de enheder, du allerede har. Alt bliver på dit netværk.</string>
    <string name="disclaimer">Nestwatch er ikke medicinsk udstyr og erstatter ikke opsyn. Se altid selv til dit barn.</string>
