    <string name="perm_camera_title">Câmera</string>
    <string name="perm_camera_station">Permita a câmera para que um dispositivo pareado possa abrir uma imagem ao vivo quando pedir. Fora isso, a câmera fica desligada, e esta tela mostra quando ela está ligada.</string>
