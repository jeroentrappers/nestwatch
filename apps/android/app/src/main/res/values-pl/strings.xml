    <string name="perm_camera_title">Kamera</string>
    <string name="perm_camera_station">Zezwól na kamerę, aby sparowane urządzenie rodzica mogło na żądanie otworzyć podgląd na żywo. W innym przypadku kamera jest wyłączona, a ten ekran pokazuje, kiedy działa.</string>
