    <string name="perm_mic_title">Mikrofon</string>
    <string name="perm_mic_station">Stacja dziecka słucha pokoju, aby urządzenia rodzica mogły go usłyszeć. Dźwięk trafia tylko do sparowanych urządzeń.</string>
