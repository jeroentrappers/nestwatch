    <string name="app_name">Nestwatch</string>
    <string name="promise">A private baby monitor for the devices you already own. Everything stays on your network.</string>
    <string name="disclaimer">Nestwatch is not a medical device and does not replace supervision. Always check on your child in person.</string>
    <string name="role_station">This device watches</string>
    <string name="role_station_hint">Put it in the child\'s room. It listens and, when asked, shows the camera.</string>
