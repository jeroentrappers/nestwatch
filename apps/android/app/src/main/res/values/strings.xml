    <!-- Permissions (security.md PRIV-4) -->
    <string name="perm_mic_title">Microphone</string>
    <string name="perm_mic_station">The station listens to the room so your listeners can hear it. Audio only goes to devices you paired.</string>
    <string name="perm_mic_talk">Talk-back sends your voice to the station while you hold the button.</string>
    <string name="perm_camera_title">Camera</string>
    <string name="perm_camera_station">Allow the camera so a paired listener can open a live view on request. The camera is off otherwise, and this screen shows when it is on.</string>
    <string name="perm_camera_scan">The camera is used to scan the station\'s pairing QR code. Nothing is recorded.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications">Nestwatch alerts you when a room gets loud, a station becomes unreachable or its battery runs low.</string>
    <string name="perm_continue">Continue</string>
    <string name="perm_not_now">Not now</string>
    <string name="perm_denied_mic">Without the microphone the station cannot listen. You can allow it in the system settings.</string>
