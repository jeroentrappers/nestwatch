    <!-- Relay (rendezvous.md FR-RV-1, §7) -->
    <string name="relay_title">Reachable through a relay server</string>
    <string name="relay_server_is">Server: %1$s</string>
    <string name="relay_explain">When home Wi-Fi or a VPN cannot reach this station, listeners can connect through a relay server. Everything stays end-to-end encrypted between your own devices.</string>
    <string name="relay_can_see">What the server can see: that this station is online, its public IP address, which addresses connect to it and when, and how much data flows.</string>
    <string name="relay_cannot_see">What it cannot see: audio, video, messages, device names, pairing codes or keys.</string>
    <string name="relay_server">Server address</string>
    <string name="relay_server_hint">For example https://nestwatch.appmire.be or your own server</string>
