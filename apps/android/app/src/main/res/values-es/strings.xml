    <!-- Permissions (security.md PRIV-4) -->
    <string name="perm_mic_title">Micrófono</string>
    <string name="perm_mic_station">La estación del bebé escucha la habitación para que los dispositivos de los padres puedan oírla. El audio solo va a los dispositivos que has vinculado.</string>
    <string name="perm_mic_talk">Hablar al bebé envía tu voz a la estación mientras mantienes pulsado el botón.</string>
    <string name="perm_camera_title">Cámara</string>
    <string name="perm_camera_station">Permite la cámara para que un dispositivo vinculado pueda abrir una imagen en directo cuando lo pida. Si no, la cámara está apagada, y esta pantalla indica cuándo está encendida.</string>
    <string name="perm_camera_scan">La cámara se usa para escanear el código QR de vinculación de la estación. No se graba nada.</string>
    <string name="perm_notifications_title">Notificaciones</string>
    <string name="perm_notifications">Nestwatch te avisa cuando hay ruido en una habitación, una estación deja de estar accesible o se le agota la batería.</string>
