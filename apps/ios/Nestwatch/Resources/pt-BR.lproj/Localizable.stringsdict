<!-- Plural strings (Brazilian Portuguese). Keys are read with trp(key, n). -->
<plist version="1.0">
<dict>
	<key>listening_count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d ouvindo</string>
			<key>many</key>
			<string>%d ouvindo</string>
			<key>other</key>
			<string>%d ouvindo</string>
		</dict>
	</dict>
	<key>pair_devices_left</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>mais %d aparelho</string>
			<key>many</key>
			<string>até %d aparelhos</string>
			<key>other</key>
			<string>até %d aparelhos</string>
		</dict>
	</dict>
	<key>trying_addresses</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>tentando %d endereço…</string>
			<key>many</key>
			<string>tentando %d endereços…</string>
			<key>other</key>
			<string>tentando %d endereços…</string>
		</dict>
	</dict>
	<key>seconds</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d segundo</string>
			<key>many</key>
			<string>%d segundos</string>
			<key>other</key>
			<string>%d segundos</string>
		</dict>
	</dict>
	<key>ago_days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>há %d dia</string>
			<key>many</key>
			<string>há %d dias</string>
			<key>other</key>
			<string>há %d dias</string>
		</dict>
	</dict>
	<key>wake_ups</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d despertar</string>
			<key>many</key>
			<string>%d despertares</string>
			<key>other</key>
			<string>%d despertares</string>
		</dict>
	</dict>
</dict>
</plist>
